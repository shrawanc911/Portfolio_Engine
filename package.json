{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./index.ts",
    "worker:cron": "ts-node-dev --respawn --transpile-only ./src/cronWorkerEntry.ts",
    "worker:portfolioProcessor": "ts-node-dev --respawn --transpile-only ./src/portfolioProcessorWorkerEntry.ts",
    "worker:stock": "ts-node-dev --respawn --transpile-only ./src/stockWorkerEntry.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');const p=require('path');const s='src/assets';const d='dist/src/assets';if(fs.existsSync(s)){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))}\"",
    "start": "node dist/index.js",
    "start:prod": "pm2-runtime start dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.1",
    "@types/socket.io": "^3.0.1",
    "@types/ws": "^8.18.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "bullmq": "^5.65.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "kiteconnect": "^5.1.0",
    "mongoose": "^8.18.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "p-limit": "^7.2.0",
    "pm2": "^5.4.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  }
}
